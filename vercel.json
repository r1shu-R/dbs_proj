{
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/health",
      "dest": "/api/index.py"
    },
    {
      "src": "/dashboard.html",
      "dest": "/frontend/dashboard.html"
    },
    {
      "src": "/booking.html",
      "dest": "/frontend/booking.html"
    },
    {
      "src": "/maintenance.html",
      "dest": "/frontend/maintenance.html"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    }
  ]
}
